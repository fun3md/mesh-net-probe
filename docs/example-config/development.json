{
  "id": "dev-admin-web-config",
  "name": "Development Admin Web Configuration",
  "version": 1,
  "created_at": "2025-11-03T20:00:00Z",
  "updated_at": "2025-11-03T20:00:00Z",
  "server": {
    "port": 8080,
    "host": "0.0.0.0",
    "read_timeout": "30s",
    "write_timeout": "30s",
    "idle_timeout": "120s",
    "max_header_bytes": 1048576
  },
  "logging": {
    "level": "debug",
    "format": "text",
    "output": "stdout",
    "enable_request_logging": true,
    "enable_access_logging": true
  },
  "cors": {
    "enabled": false,
    "allowed_origins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://127.0.0.1:3000",
      "http://127.0.0.1:5173"
    ],
    "allowed_methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "allowed_headers": ["Content-Type", "Authorization", "X-Requested-With"],
    "exposed_headers": ["X-Total-Count"],
    "allow_credentials": true,
    "max_age": "1h"
  },
  "authentication": {
    "enabled": false,
    "jwt_secret": "development-secret-key-change-in-production",
    "token_expiry": "24h",
    "refresh_token_expiry": "7d",
    "rate_limit": {
      "enabled": true,
      "requests_per_minute": 100,
      "burst": 20
    }
  },
  "monitoring": {
    "health_check_interval": "30s",
    "metrics_enabled": true,
    "metrics_endpoint": "/metrics",
    "tracing_enabled": false,
    "profiling_enabled": true,
    "profiling_endpoint": "/debug/pprof"
  },
  "features": {
    "websocket_enabled": true,
    "real_time_updates": true,
    "configuration_hot_reload": true,
    "debug_endpoints": true
  },
  "probes": {
    "default_timeout": "5s",
    "max_concurrent_measurements": 100,
    "measurement_buffer_size": 10000,
    "retention_period": "24h"
  },
  "api_rate_limits": {
    "health_endpoint": "1000/minute",
    "config_endpoints": "100/minute", 
    "probe_endpoints": "200/minute",
    "measurement_endpoints": "500/minute"
  },
  "development": {
    "hot_reload": true,
    "mock_data": false,
    "verbose_errors": true,
    "request_logging": true,
    "slow_request_threshold": "100ms"
  }
}