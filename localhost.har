            "text": "import __vite__cjsImport0_react from \"/node_modules/.vite/deps/react.js?v=570fec67\"; const useState = __vite__cjsImport0_react[\"useState\"]; const useEffect = __vite__cjsImport0_react[\"useEffect\"]; const useCallback = __vite__cjsImport0_react[\"useCallback\"];\nimport apiService from \"/src/services/api.ts\";\nconst TOKEN_KEY = \"auth_token\";\nconst USER_KEY = \"user\";\nlet initialAuthCheckStarted = false;\nconst AUTH_STATE_KEY = \"__mesh_probe_auth_state__\";\nfunction readGlobalAuthState() {\n  if (typeof window === \"undefined\") return null;\n  const anyWin = window;\n  return anyWin[AUTH_STATE_KEY] || null;\n}\nfunction writeGlobalAuthState(state) {\n  if (typeof window === \"undefined\") return;\n  const anyWin = window;\n  anyWin[AUTH_STATE_KEY] = state;\n}\nexport function useAuth() {\n  const [state, setState] = useState({\n    user: null,\n    token: null,\n    isAuthenticated: false,\n    loading: true\n  });\n  const loadFromStorage = useCallback(() => {\n    const token = localStorage.getItem(TOKEN_KEY);\n    const rawUser = localStorage.getItem(USER_KEY);\n    if (!token) {\n      return {\n        token: null,\n        user: null,\n        isAuthenticated: false\n      };\n    }\n    try {\n      const user = rawUser ? JSON.parse(rawUser) : null;\n      return {\n        token,\n        user,\n        isAuthenticated: !!user\n      };\n    } catch {\n      localStorage.removeItem(USER_KEY);\n      return {\n        token,\n        user: null,\n        isAuthenticated: false\n      };\n    }\n  }, []);\n  const applyAuthState = useCallback((next) => {\n    setState((prev) => {\n      const merged = {\n        ...prev,\n        ...next\n      };\n      writeGlobalAuthState(merged);\n      return merged;\n    });\n  }, []);\n  const clearAuth = useCallback(async () => {\n    try {\n      await apiService.logout().catch(() => {\n      });\n    } finally {\n      apiService.clearAuthToken();\n      localStorage.removeItem(TOKEN_KEY);\n      localStorage.removeItem(USER_KEY);\n      applyAuthState({\n        user: null,\n        token: null,\n        isAuthenticated: false\n      });\n    }\n  }, [applyAuthState]);\n  useEffect(() => {\n    let isMounted = true;\n    const existing = readGlobalAuthState();\n    if (existing && isMounted) {\n      setState(existing);\n    }\n    const bootstrap = async () => {\n      if (initialAuthCheckStarted) {\n        const shared = readGlobalAuthState();\n        if (shared && isMounted) {\n          setState(shared);\n        } else {\n          applyAuthState({ loading: false });\n        }\n        return;\n      }\n      initialAuthCheckStarted = true;\n      const { token } = loadFromStorage();\n      console.debug(\"[useAuth] bootstrap: loaded token from storage\", { hasToken: !!token });\n      if (!token) {\n        apiService.clearAuthToken();\n        if (!isMounted) return;\n        applyAuthState({\n          user: null,\n          token: null,\n          isAuthenticated: false,\n          loading: false\n        });\n        console.debug(\"[useAuth] bootstrap: no token, unauthenticated\");\n        return;\n      }\n      apiService.setAuthToken(token);\n      try {\n        const me = await apiService.getCurrentUser();\n        if (!isMounted) return;\n        localStorage.setItem(USER_KEY, JSON.stringify(me));\n        applyAuthState({\n          user: me,\n          token,\n          isAuthenticated: true,\n          loading: false\n        });\n        console.debug(\"[useAuth] bootstrap: /auth/me success, authenticated\", { me });\n      } catch (error) {\n        if (!isMounted) return;\n        apiService.clearAuthToken();\n        localStorage.removeItem(TOKEN_KEY);\n        localStorage.removeItem(USER_KEY);\n        applyAuthState({\n          user: null,\n          token: null,\n          isAuthenticated: false,\n          loading: false\n        });\n        console.debug(\"[useAuth] bootstrap: /auth/me failed, cleared auth\", { error });\n      }\n    };\n    bootstrap();\n    return () => {\n      isMounted = false;\n    };\n  }, [applyAuthState, loadFromStorage]);\n  const login = useCallback(\n    async (username, password) => {\n      applyAuthState({ loading: true });\n      try {\n        const { token, user } = await apiService.login({ username, password });\n        localStorage.setItem(TOKEN_KEY, token);\n        localStorage.setItem(USER_KEY, JSON.stringify(user));\n        apiService.setAuthToken(token);\n        const nextState = {\n          user,\n          token,\n          isAuthenticated: true,\n          loading: false\n        };\n        writeGlobalAuthState(nextState);\n        setState(nextState);\n        console.debug(\"[useAuth] login: success\", { user });\n      } catch (error) {\n        apiService.clearAuthToken();\n        localStorage.removeItem(TOKEN_KEY);\n        localStorage.removeItem(USER_KEY);\n        const nextState = {\n          user: null,\n          token: null,\n          isAuthenticated: false,\n          loading: false\n        };\n        writeGlobalAuthState(nextState);\n        setState(nextState);\n        console.debug(\"[useAuth] login: failed, cleared auth\", { error });\n        throw error;\n      }\n    },\n    [applyAuthState]\n  );\n  const logout = useCallback(async () => {\n    applyAuthState({ loading: true });\n    await clearAuth();\n    applyAuthState({ loading: false });\n  }, [applyAuthState, clearAuth]);\n  const refresh = useCallback(async () => {\n    if (!state.token) {\n      return;\n    }\n    try {\n      const { token } = await apiService.refreshToken();\n      localStorage.setItem(TOKEN_KEY, token);\n      apiService.setAuthToken(token);\n      applyAuthState({ token, isAuthenticated: true });\n    } catch {\n      await clearAuth();\n    }\n  }, [state.token, applyAuthState, clearAuth]);\n  return {\n    user: state.user,\n    token: state.token,\n    isAuthenticated: state.isAuthenticated,\n    loading: state